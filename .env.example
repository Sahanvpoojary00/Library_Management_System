# =============================================
# Smart Library Management System - Env Config
# =============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
NODE_ENV=development   # change to "production" on Render

# --- Database (Local XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_management_system
DB_SSL=false           # set to "true" for PlanetScale

# --- Database (PlanetScale Cloud) ---
# DB_HOST=aws.connect.psdb.cloud
# DB_USER=your_planetscale_username
# DB_PASSWORD=your_planetscale_password
# DB_NAME=library_management_system
# DB_SSL=true

# --- Auth ---
JWT_SECRET=your_super_secret_jwt_key_change_this_immediately

# --- CORS (Render production) ---
# Comma-separated list of allowed frontend origins
# FRONTEND_URL=https://your-app.vercel.app
